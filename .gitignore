# Qt runtime binaries (don't need versioning - these are shipped with YRCARKIT.exe)
*.dll
opengl32sw.dll
D3Dcompiler_47.dll

# Qt plugin dirs
iconengines/
imageformats/
platforms/
sqldrivers/

# Temp / log files
*.log
*.tmp
*~

# Python
__pycache__/
*.pyc

# Battery UI local store gets pushed via auto_push.ps1 — provides hourly backup
# in case of laptop power-loss or disk failure. Keep journal/wal noise out though.
battery_ui/battery_ui.db-journal
battery_ui/battery_ui.db-wal
battery_ui/battery_ui.db-shm

# Cloudflare tunnel binary (62 MB, downloadable on demand) + secrets
tunnel/cloudflared.exe
tunnel/credentials.json
tunnel/tunnel-url.txt
tunnel/tunnel.log

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
